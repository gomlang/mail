package tests;

use ecosystem::mail;
use std::bytes;
use std::testing;

#[test]
fn downstream_header_literals_do_not_create_extra_recipients() -> () {
    let headers = testing::expect_ok(
        mail::parse_headers(
            bytes::Bytes::from_string("To: a@[x,y;z], b@example.test\r\n\r\n"),
            mail::Limits::standard(),
        ),
        "headers",
    );
    let addresses = testing::expect_ok(
        headers.addresses("To", mail::Limits::standard()),
        "recipients",
    );
    testing::assert_eq(addresses.len(), 2);
    testing::assert_eq(addresses[0].domain, "[x,y;z]");
}

#[test]
fn downstream_display_brackets_require_quoting() -> () {
    testing::assert_err(mail::parse_address_list("Name [)] <a@b.test>", mail::Limits::standard()));
    let addresses = testing::expect_ok(
        mail::parse_address_list("\"Name [)]\" <a@[x)y]>", mail::Limits::standard()),
        "quoted display with domain literal",
    );
    testing::assert_eq(addresses[0].name, "Name [)]");
    testing::assert_eq(addresses[0].domain, "[x)y]");
}
