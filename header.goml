package mail;

use ecosystem::mime;
use ecosystem::textproto;
use std::bytes;
use std::io;

pub fn decode_header_value(value: string, limits: Limits) -> Result[string, Error] {
    limits.validate()?;
    if value.byte_len() > limits.max_value_bytes {
        return Result::Err(failure(ErrorKind::Limit, 0, "header value exceeds limit"))
    }
    mime::decode_header(
        value,
        mime::Limits {
            max_input_bytes: limits.max_value_bytes,
            max_parameters: 0,
            max_value_bytes: limits.max_value_bytes,
            max_output_bytes: limits.max_decoded_bytes,
        },
    ).map_err(
        |error| failure(
            if error.kind == mime::ErrorKind::Limit {
                ErrorKind::Limit
            } else {
                ErrorKind::Encoding
            },
            error.offset,
            error.message,
        ),
    )
}

fn header_space(value: byte) -> bool {
    value == b' ' || value == b'\t'
}

fn unfolded_value(input: bytes::Bytes, position: Ref[isize], header_end: isize, limit: isize) -> Result[
    bytes::Bytes,
    Error,
] {
    let mut cursor = position.get();
    // Framing and field syntax have already been validated by textproto.
    while input.get(cursor) != b':' {
        cursor += 1;
    }
    cursor += 1;
    let mut start = -1;
    let mut end = cursor;
    let mut length = 0;
    let mut value_length = 0;
    loop {
        while cursor + 1 < header_end
            && !(input.get(cursor) == b'\r' && input.get(cursor + 1) == b'\n') {
            let space = header_space(input.get(cursor));
            if start < 0 && !space {
                start = cursor;
            }
            if start >= 0 {
                length += 1;
            }
            if !space {
                end = cursor + 1;
                value_length = length;
            }
            cursor += 1;
        }
        cursor += 2;
        if cursor >= header_end || !header_space(input.get(cursor)) {
            break
        }
    }
    position.set(cursor);
    if value_length > limit {
        return Result::Err(failure(ErrorKind::Limit, cursor, "header value exceeds limit"))
    }
    let output = bytes::Bytes::new();
    if start >= 0 {
        cursor = start;
        while cursor < end {
            if input.get(cursor) == b'\r' {
                cursor += 2;
            } else {
                output.push(input.get(cursor));
                cursor += 1;
            }
        }
    }
    Result::Ok(output)
}

pub fn parse_headers(input: bytes::Bytes, limits: Limits) -> Result[Headers, Error] {
    limits.validate()?;
    if input.len() > limits.max_input_bytes {
        return Result::Err(failure(ErrorKind::Limit, 0, "message input exceeds limit"))
    }
    let source = textproto::Reader::new(
        io::Cursor::new(input),
        textproto::Limits {
            max_line_bytes: limits.max_line_bytes,
            max_header_bytes: limits.max_header_bytes,
            max_headers: limits.max_headers,
            // The mail value budget applies after preserving fold whitespace.
            // The intermediate normalized value remains bounded by the block.
            max_value_bytes: limits.max_header_bytes,
            max_dot_bytes: 0,
        },
    ).map_err(|error| failure(ErrorKind::Limit, error.offset, error.message))?;
    let raw = source.read_headers(true).map_err(
        |error| failure(
            if error.kind == textproto::ErrorKind::Limit {
                ErrorKind::Limit
            } else {
                ErrorKind::Header
            },
            error.offset,
            error.message,
        ),
    )?;
    let fields = Vec::new();
    let position = Ref::new(0);
    for field in raw.fields() {
        let field = textproto::Field {
            value: unfolded_value(input, position, source.offset(), limits.max_value_bytes)?,
            ..field,
        };
        let value = field.value_text().map_err(
            |error| failure(ErrorKind::Encoding, source.offset(), error.message),
        )?;
        fields.push(Field { name: field.name, value });
    }
    Result::Ok(Headers { fields_value: fields, body_offset_value: source.offset() })
}
